{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    // Deno requires an explicit extension on every relative import, and the
    // Edge Functions are Deno. Without this the same files cannot be both
    // type-checked here and deployed there — which is how they reached their
    // first deploy attempt with 82 imports Deno could not resolve.
    //
    // Permissive rather than mandatory: nothing in the app uses it, and
    // `noEmit` is already set, which is the condition TypeScript attaches.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/app/*": ["./app/*"],
      "@/features/*": ["./features/*"],
      "@/components/*": ["./components/*"],
      "@/lib/*": ["./lib/*"],
      "@/types/*": ["./types/*"],
      "@/types": ["./types/index.ts"],
      "@/assets/*": ["./assets/*"]
    },
    // The coastline is a generated JSON asset imported by `lib/map/landmass.ts`
    // (ADR-0028). Metro already bundles it; this is what lets `tsc` see it.
    "resolveJsonModule": true,
    "types": ["jest", "node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "global.d.ts"
  ],
  "exclude": ["node_modules", "android", "ios", "supabase/functions/*/index.ts"]
}
