# Copy to .env and fill in. No credential is ever committed (CLAUDE.md §9).
#
# The Maps SDK rendering key is the ONLY Google credential the client may hold,
# and it must be restricted by bundle ID and SHA-1 to the Maps SDK alone
# (ADR-0006). Every other Google call is made by a Supabase Edge Function, whose
# service-account credentials live in Supabase secrets and never reach the app.
EXPO_PUBLIC_MAPS_API_KEY_IOS=
EXPO_PUBLIC_MAPS_API_KEY_ANDROID=

# Supabase project. The anon key is public by design; access is decided by RLS
# and by the Edge Functions, never by possession of this key (ADR-0011).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Cloud Map IDs, one per theme. Identifiers, not credentials — they name a style
# in the Google Cloud console and grant nothing. Unset is supported: the map
# falls back to Google's default style rather than rendering blank (risk C15).
EXPO_PUBLIC_MAP_ID_LIGHT=
EXPO_PUBLIC_MAP_ID_DARK=
