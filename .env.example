# Copy to a local ignored .env and fill in the public Supabase client settings.
# Never commit a populated .env or place provider REST secrets in the mobile app.

# Supabase project. The anon key is public by design; RLS and Edge Functions
# decide access rather than possession of this value.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Flutter builds receive SUPABASE_URL and SUPABASE_ANON_KEY through --dart-define.
# HERE_SDK_ACCESS_KEY_ID and HERE_SDK_ACCESS_KEY_SECRET are injected only by CI.
# ORS_API_KEY and HERE_REST_API_KEY exist only as Supabase Edge Function secrets.
# Google OAuth configuration remains in Supabase Auth and is unrelated to maps.
